# Agent X-Ray — Caddy 反代(备案通过并解析域名后,把 :80 换成你的域名即自动 TLS)
# 备案期自测:改成 :8080 并在安全组放行对应端口。
:80 {
	encode zstd gzip

	# API(含两条 SSE:/api/agent/*、/api/trace/stream)
	#
	# 端口契约:Encore 自托管镜像默认监听 8080,compose 里用 PORT=4000 显式对齐这里。
	# 两处必须同改,别只改一边(deploy/docker-compose.yml 的 api.environment)。
	handle /api/* {
		uri strip_prefix /api
		reverse_proxy api:4000 {
			# SSE 长连接:-1 = 每次写入立即 flush,不做响应缓冲。
			# Caddy 的 reverse_proxy 默认不设响应超时,长连接不会被自己掐断;
			# 若将来在前面加云 LB / CDN,必须为这两条 SSE 路径单独关闭缓冲与空闲超时。
			flush_interval -1
		}
	}

	# RSS 订阅源(R5)。设计稿画板 2d 的订阅地址就是站根下的 /rss.xml 与
	# /rss/<分类>.xml,不带 /api 前缀,所以必须在这里单独指到 api;
	# 少了这两条的表现是订阅弹层给的地址全部 404 到 Next 上。
	handle /rss.xml {
		reverse_proxy api:4000
	}
	handle /rss/* {
		reverse_proxy api:4000
	}

	# Notes 正文配图(R6)。图片存在 Postgres 里、由 api 运行期供图
	# (所有者裁定:镜像内不烧任何 notes 内容),但**对外 URL 保持
	# /notes/<系列>/<哈希>.webp 不变** —— 存量正文里的 markdown 就是这么写的。
	#
	# 【为什么按扩展名分流】文章页地址是 /notes/<系列>/<章节>,与图片地址同形;
	# 唯一可靠的区分是扩展名。少了这条的表现是正文里的图全部 404 到 Next 上。
	# 【为什么要 rewrite】Encore 路由里 /notes/:series/:file 会和既有的
	# /notes/series/:slug 撞车,所以 api 侧的路径是 /assets/notes/…,这里补前缀。
	# next.config.ts 有同款 dev 规则,两处改动要同步。
	@notesAsset path_regexp ^/notes/[^/]+/[^/]+\.(?:webp|png|jpe?g|gif)$
	handle @notesAsset {
		rewrite * /assets{path}
		reverse_proxy api:4000
	}

	# MCP 管理面可选 IP 白名单(docs/security.md §4;启用时取消注释并填入自己的出口 IP)。
	# /api/mcp 已有静态 bearer token 认证,这一层是纵深防御,不是唯一防线。
	# @mcpBlocked {
	# 	path /api/mcp*
	# 	not remote_ip 1.2.3.4
	# }
	# respond @mcpBlocked 403

	# 前端(Next.js)
	handle {
		reverse_proxy web:3000
	}
}
