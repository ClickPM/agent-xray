# 复制为 .env 并 chmod 600;所有真实值不入 Git
#
# 镜像坐标 —— 不可变制品,IMAGE_TAG 必须是 git SHA,禁止 latest(compose 里已用
# ${IMAGE_TAG:?} 强制,留空会直接拒绝启动)。回滚 = 换成上一个 SHA 再 up -d。
IMAGE_TAG=
# 私有 registry 前缀;用 docker save/load 传输时保持默认 local 即可
IMAGE_REGISTRY=local

# Postgres —— 库名 agent / 用户 app 由 compose 固定,这里只给密码。
# 该值同时被 deploy/infra-config.json 以 {"$env":"POSTGRES_PASSWORD"} 引用。
POSTGRES_PASSWORD=change-me

# LLM 凭据 —— 被 infra-config.json 以 {"$env":"DEEPSEEK_API_KEY"} 绑定到
# Encore secret `DeepSeekApiKey`。境内直连不通时填海外中转端点的 key。
# 这是「引导凭据例外」(docs/security.md §3):自托管镜像没有管理后台之前,
# Encore secret 只能走 .env 注入;R7 加密入库落地后运行期 key 以库内为准。
DEEPSEEK_API_KEY=

# —— 以下为后续轮次占位,代码里尚未声明对应 secret,现在填了也不会被读取 ——
# R6 pi 只读工具专用连接(agent_ro 角色,仅 SELECT notes_*)
# AGENT_RO_PASSWORD=
# R7 管理后台(argon2id 哈希,生成方式见 docs/security.md §4)
# ADMIN_PASSWORD_HASH=
# R7 LLM 海外中转基址(见 docs/deploy-cn-lightweight.md §3)
# LLM_PROXY_BASE=
