# deploy/.env 模板 —— 复制成 .env 后逐项填写,并 chmod 600。
# 本文件入库,.env 永不入库(见 .gitignore)。

# 正在部署的镜像 tag。必须是 git 短 SHA;compose 与 migrate.sh 都会硬校验,
# 禁止 latest 等可变 tag(CLAUDE.md 规则 10)。
IMAGE_TAG=

# 镜像仓库前缀。save/load 文件传输流程留空即可(默认 local)。
#IMAGE_REGISTRY=

# Postgres 密码。首次部署时生成,之后不要改(改了要同步改库里的角色口令)。
POSTGRES_PASSWORD=

# ── MCP 管理面(R6)────────────────────────────────────────────────
# 注意:这两项**都不是可直接使用的凭据**,泄漏它们不等于拿到管理权或 LLM key。
#
# ⚠️ 两处都必须用**密码学安全**的随机源。PowerShell 5.1 的 `Get-Random` 背后是
#    System.Random(非密码学 PRNG),用它生成 token 或密钥等于让「高熵」这条要求
#    (docs/security.md §4)名存实亡。下面用 RandomNumberGenerator。
#    同理不要用 .NET 5+ 才有的 `SHA256::HashData` —— PS 5.1 跑在 .NET Framework 上,
#    那个静态方法不存在,命令会直接报错(实测)。
#
# 管理面 bearer token 的 sha256(hex,小写)。原 token 只在所有者手里,服务端只存哈希。
# 生成(PowerShell 5.1,整段一起跑):
#   $b = New-Object byte[] 32
#   [System.Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b)
#   $t = [Convert]::ToBase64String($b); $t     # ← 这个是 token,存进你的密码管理器
#   $sha = [System.Security.Cryptography.SHA256]::Create()
#   [BitConverter]::ToString($sha.ComputeHash([Text.Encoding]::UTF8.GetBytes($t))).Replace("-","").ToLower()
#                                              # ← 这个填下面
MCP_AUTH_TOKEN_HASH=

# llm_config 里 LLM key 的 AES-256-GCM 密钥,32 字节的 base64。
# 生成(PowerShell 5.1):
#   $k = New-Object byte[] 32
#   [System.Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($k)
#   [Convert]::ToBase64String($k)
# ⚠️ 换掉它,库里既有的 LLM key 密文全部解不开,agent 立刻停摆,
#    必须经 MCP 的 llm_provider_upsert 把各 provider 的 key 重写一遍。
CONFIG_ENCRYPTION_KEY=

# ⚠️ R6 起没有 LLM 引导密钥(原 DEEPSEEK_API_KEY 已按所有者裁定移除)。
# 运行期 LLM 凭据的唯一来源是 llm_config 表:**首次部署完成后,必须先经
# MCP 的 llm_provider_upsert 写入一个 provider,agent 对话才可用**
# (在那之前 /agent/ask 回 503)。流程见 docs/deploy-environments.md。

# 对外访问地址,**必须含 scheme,必要时含端口**。RSS 条目里的绝对链接、
# 订阅弹层展示与复制的地址都取它。
#   生产    https://agent-xray.dev
#   130 预发 http://<内网IP>:8080     ← 备案通过前 Caddy 只跑明文
# 写错的后果不是报错而是订阅源里的链接全指向一个没在听的端点。
SITE_ORIGIN=

# ── 高危工具双闸之一(R7,默认不设)────────────────────────────────
# XRAY_UNLOCK_DANGEROUS_TOOLS=1 只是第一闸,另一闸是 tool_config 里那一行的
# dangerous/enabled。**当前注册表里没有任何 dangerous 工具**,所以这个变量目前无用武之地;
# bash / write / 任意代码执行类工具永久禁止进 in-process 进程(docs/security.md §1 第 1 层),
# 设了它也长不出来。
#
# 另注:R7 的 agent_ro 只读角色**不需要任何变量** —— 它是 NOLOGIN 角色,
# 由应用连接在事务里 SET LOCAL ROLE 临时降权,没有第二套连接串、也没有第二份口令。
#XRAY_UNLOCK_DANGEROUS_TOOLS=
